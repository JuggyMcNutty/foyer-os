# Maintainer: JuggyMcNutty <JuggyMcNutty@users.noreply.github.com>
# Official Jellyfin desktop client (Qt6 + libmpv), TV mode. Foyer's Jellyfin tile.
pkgname=foyer-jellyfin-desktop
_pkgname=jellyfin-desktop
pkgver=2.1.0_pre2
_tag=v2.1.0-pre2
_mpvqt=2ebbd38bf65d01be9c55d673ecd43c8bb9a6fc8e
pkgrel=0
pkgdesc="Jellyfin desktop client (Qt6 + mpv), built for Foyer"
url="https://github.com/jellyfin/jellyfin-desktop"
arch="x86_64 aarch64"
license="GPL-2.0-or-later"
depends="qt6-qtwebengine qt6-qtwebchannel qt6-qtdeclarative mpv-libs"
makedepends="cmake samurai qt6-qtbase-dev qt6-qtbase-private-dev qt6-qtwebengine-dev qt6-qtwebchannel-dev
	qt6-qtdeclarative-dev qt6-qtdeclarative-private-dev mpv-dev sdl2-dev libcec-dev python3 extra-cmake-modules"
provides="jellyfin-desktop=$pkgver-r$pkgrel"
source="$_pkgname-$_tag.tar.gz::https://github.com/jellyfin/jellyfin-desktop/archive/refs/tags/$_tag.tar.gz
	mpvqt-$_mpvqt.tar.gz::https://invent.kde.org/libraries/mpvqt/-/archive/$_mpvqt/mpvqt-$_mpvqt.tar.gz"
builddir="$srcdir/$_pkgname-${_tag#v}"
options="!check"

prepare() {
	default_prepare
	rmdir external/mpvqt 2>/dev/null || rm -rf external/mpvqt
	mv "$srcdir/mpvqt-$_mpvqt" external/mpvqt
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUSE_STATIC_MPVQT=ON \
		-DBUILD_TESTING=OFF \
		-DCHECK_FOR_UPDATES=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

