7769952d9cafb32f49537dce27c7d9fd390640e4167e6c459384b640cbfbf76a8a925aa648740a6fb04df2ae68699313f647e83d3838c086b3d2cf130b8b0825  jellyfin-desktop-v2.1.0-pre2.tar.gz
27a0a6932747827db433f6926e26a38d25fa96f99d8d7fd56929557e605f692de47600392a54bd4a554ce7677e85ef50ebd83763b58e047d334f19aab7d6ff27  mpvqt-2ebbd38bf65d01be9c55d673ecd43c8bb9a6fc8e.tar.gz
"
