# Maintainer: JuggyMcNutty <JuggyMcNutty@users.noreply.github.com>
# Red: Qt6 YouTube client with a TV (living-room) mode. Foyer's YouTube tile.
pkgname=foyer-red
_pkgname=red
pkgver=10.4.0
pkgrel=0
pkgdesc="Red YouTube client (TV mode), built for Foyer"
url="https://github.com/keshavbhatt/red"
arch="x86_64 aarch64"
license="GPL-3.0-or-later"
depends="qt6-qtwebengine qt6-qtsvg"
makedepends="cmake samurai qt6-qtbase-dev qt6-qtwebengine-dev qt6-qtwebchannel-dev qt6-qtsvg-dev qt6-qtdeclarative-dev"
provides="red=$pkgver-r$pkgrel"
source="$_pkgname-$pkgver.tar.gz::https://github.com/keshavbhatt/red/archive/refs/tags/v$pkgver.tar.gz
	musl-execinfo.patch"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_SKIP_INSTALL_RPATH=ON \
		-DRED_BUILD_TESTS=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

