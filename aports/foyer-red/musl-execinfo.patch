diff --git a/src/platform/linux/crash_handler_posix.cpp b/src/platform/linux/crash_handler_posix.cpp
index f96895f..7ff33a2 100644
--- a/src/platform/linux/crash_handler_posix.cpp
+++ b/src/platform/linux/crash_handler_posix.cpp
@@ -6,7 +6,14 @@
 #include <array>
 #include <csignal>
 #include <cstring>
-#include <execinfo.h>
+#if defined(__GLIBC__) || defined(__has_include)
+#  if defined(__has_include)
+#    if __has_include(<execinfo.h>)
+#      include <execinfo.h>
+#      define RED_HAVE_EXECINFO 1
+#    endif
+#  endif
+#endif
 #include <fcntl.h>
 #include <unistd.h>
 
@@ -52,8 +59,13 @@ extern "C" void handleFatalSignal(int sig)
             writeAll(fd, signalName(sig));
             writeAll(fd, "\n\n");
             std::array<void*, 64> frames{};
+#ifdef RED_HAVE_EXECINFO
             const int count = ::backtrace(frames.data(), static_cast<int>(frames.size()));
             ::backtrace_symbols_fd(frames.data(), count, fd); // async-signal-safe
+#else
+            const int count = 0;
+            (void)frames;
+#endif
             ::close(fd);
         }
     }
@@ -80,8 +92,10 @@ void installCrashHandler(const QString& crashFilePath)
 
     // Warm up libgcc's unwinder so backtrace() in the handler needs no first-call
     // allocation (which would not be async-signal-safe).
+#ifdef RED_HAVE_EXECINFO
     std::array<void*, 4> warm{};
     ::backtrace(warm.data(), static_cast<int>(warm.size()));
+#endif
 
     struct sigaction action = {};
     action.sa_handler = handleFatalSignal;
