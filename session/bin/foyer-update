#!/bin/sh
# foyer-update — install the latest (or a pinned) foyer-os release from GitHub.
#   foyer-update [--check] [TAG]
# APKs are unsigned release assets, installed with --allow-untrusted.
set -eu
REPO="${FOYER_REPO:-JuggyMcNutty/foyer-os}"
ARCH=$(apk --print-arch)
CHECK=0
[ "${1:-}" = "--check" ] && { CHECK=1; shift; }
TAG="${1:-latest}"
api="https://api.github.com/repos/$REPO/releases/$([ "$TAG" = latest ] && echo latest || echo "tags/$TAG")"
json=$(curl -fsSL "$api") || { echo "foyer-update: cannot reach $api" >&2; exit 1; }
rel=$(printf '%s' "$json" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
cur=$(cat /etc/foyer/release 2>/dev/null || echo none)
echo "installed: $cur   available: $rel"
[ $CHECK = 1 ] && { [ "$rel" != "$cur" ] && exit 10 || exit 0; }
urls=$(printf '%s' "$json" | sed -n 's/.*"browser_download_url": *"\([^"]*'"$ARCH"'[^"]*\.apk\)".*/\1/p')
[ -n "$urls" ] || { echo "foyer-update: no $ARCH apks in release $rel" >&2; exit 1; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
for u in $urls; do echo "fetch $(basename "$u")"; curl -fsSL -o "$tmp/$(basename "$u")" "$u"; done
apk add --allow-untrusted --upgrade "$tmp"/*.apk
echo "$rel" > /etc/foyer/release
echo "foyer-update: now at $rel (restart the session or reboot to apply)"
