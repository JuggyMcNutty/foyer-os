    VIC[124]="5120x2160@48"
    VIC[125]="5120x2160@50"
    VIC[126]="5120x2160@60"
    VIC[127]="5120x2160@100"
    VIC[193]="5120x2160@120"
    VIC[194]="7680x4320@24"
    VIC[195]="7680x4320@25"
    VIC[196]="7680x4320@30"
    VIC[197]="7680x4320@48"
    VIC[198]="7680x4320@50"
    VIC[199]="7680x4320@60"
    VIC[200]="7680x4320@100"
    VIC[201]="7680x4320@120"
    VIC[202]="7680x4320@24"
    VIC[203]="7680x4320@25"
    VIC[204]="7680x4320@30"
    VIC[205]="7680x4320@48"
    VIC[206]="7680x4320@50"
    VIC[207]="7680x4320@60"
    VIC[208]="7680x4320@100"
    VIC[209]="7680x4320@120"
    VIC[210]="10240x4320@24"
    VIC[211]="10240x4320@25"
    VIC[212]="10240x4320@30"
    VIC[213]="10240x4320@48"
    VIC[214]="10240x4320@50"
    VIC[215]="10240x4320@60"
    VIC[216]="10240x4320@100"
    VIC[217]="10240x4320@120"
    VIC[218]="4096x2160@100"
}
{ for (i = 1; i <= NF; i++) ED[N++] = $i + 0 }
END {
    if (N < 128) exit 1
    s = 0
    for (i = 0; i < 128; i++) s += ED[i]
    if (s % 256) exit 1                     # bad base checksum: fall back
    emit("make", letters(ED[8], ED[9]))
    emit("model", ED[10] + ED[11] * 256)
    if (ED[16] && ED[17]) emit("year", 1990 + ED[17])
    if (ED[21] && ED[22]) {
        d = int(sqrt(ED[21] * ED[21] + ED[22] * ED[22]) / 2.54 * 10 + 0.5) / 10.0
        emit("size", ED[21] " x " ED[22] " cm (" d " in)")
    }
    if (ED[23] && ED[23] != 255) emit("gamma", int(ED[23] + 100) / 100.0)
    for (k = 0; k < 4; k++) {               # descriptors 1..4 at 54+18k
        o = 54 + 18 * k
        if (ED[o] == 0 && ED[o + 1] == 0) {
            if (ED[o + 3] == 0xFC) NAME = dstr(o)
            else if (ED[o + 3] == 0xFF) SERIAL = dstr(o)
        } else if (k == 0 || ED[o] + ED[o + 1] > 0) {
            dtd(o)                           # DTD 1 = preferred mode
        }
    }
    for (i = 0; i < 24; i++)                # established timings I/II
        if (int(ED[35 + int(i / 8)] / PW2[i % 8]) % 2) add_str_mode(EST[i])
    for (i = 0; i < 8; i++) {               # standard timings
        x = ED[38 + i * 2]; y = ED[39 + i * 2]
        if (x <= 1) continue
        w = (x + 31) * 8
        h = int(y / 64)
        h = h == 0 ? w * 10 / 16 : h == 1 ? w * 3 / 4 : h == 2 ? w * 4 / 5 : w * 9 / 16
        add_mode(w, h, y % 64 + 60, 0)
    }
    ext = ED[126]
    if (ext > 8) ext = 8
    for (e = 1; e <= ext; e++) cta(128 * e)
    # ---- emit ----
    if (NAME != "") emit("name", NAME)
    if (SERIAL != "") emit("serial", SERIAL)
    if (PREFW) emit("preferred", PREFW "x" PREFH "@" PREFR)
    if (NATW) emit("native", NATW "x" NATH "@" NATR)
    if (HDR != "") emit("hdr", HDR)
    if (HDRMAX > 0) emit("hdr_max", HDRMAX " cd/m2")
    if (AMDVRR != "" && VRR == "") emit("vrr", AMDVRR " (AMD FreeSync)")
    if (COL != "") emit("colorimetry", COL)
    if (DC != "") emit("deepcolor", DC)
    if (CB2 != "") emit("cb420_depth", CB2)
    if (CB420 != "") { gsub(/,$/, "", CB420); sub(/^ /, "", CB420); emit("cb420", CB420) }
    if (AUD != "") emit("audio", AUD)
    nk = 0
    for (k in MODE) KEYS[nk++] = k
    # sort by area desc, then rate desc: simple insertion (n is small)
    for (i = 0; i < nk; i++) {
        split(KEYS[i], a, "@"); split(a[1], b, "x"); A2[i] = b[1] * b[2]; A3[i] = a[2] + 0
        A1[i] = KEYS[i]
    }
    for (i = 0; i < nk; i++) for (j = i + 1; j < nk; j++) {
        if (A2[j] > A2[i] || (A2[j] == A2[i] && A3[j] > A3[i])) {
            t = A1[i]; A1[i] = A1[j]; A1[j] = t
            t = A2[i]; A2[i] = A2[j]; A2[j] = t
            t = A3[i]; A3[i] = A3[j]; A3[j] = t
        }
    }
    nat = NATW "x" NATH "@" NATR
    pref = PREFW "x" PREFH "@" PREFR
    for (i = 0; i < nk; i++) {
        f = ""
        if (A1[i] == nat) f = "native"
        else if (A1[i] == pref) f = "preferred"
        split(A1[i], a2, "@")
        printf "mode\t%s\t%s\t%s\n", a2[1], a2[2], f
    }
}'
    [ $? -ne 0 ] && return 1
    return 0
}

# Full display report for the launcher / session.sh: connector lines plus
# the EDID report of the first *connected* connector (or its sysfs modes).
display_report() {
    for c in /sys/class/drm/card*-*/; do
        [ -r "$c/status" ] || continue
        st=$(cat "$c/status")
        n=${c%/}; n=${n##*/}; n=${n#card*-}
        case "$n" in
            eDP*) t="embedded DisplayPort" ;;
            DP*) t="DisplayPort" ;;
            HDMI*) t="HDMI" ;;
            *) t="video" ;;
        esac
        printf 'connector\t%s\t%s\t%s\n' "$n" "$st" "$t"
        [ "$st" = connected ] || continue
        # (sysfs binary attrs stat as size 0; -r alone is the right test)
        if [ -r "$c/edid" ] && edid_parse "$c/edid"; then
            return 0
        fi
        # No (valid) EDID: sysfs lists resolutions without refresh rates.
        grep -v 'i$' "$c/modes" 2>/dev/null | awk -v pre=1 '!seen[$0]++ {
            printf "mode\t%s\t60\t%s\n", $0, (pre-- > 0 ? "preferred" : "")
        }'
        return 0
    done
    return 1
}

GROUP="$1"; CMD="$2"
[ $# -ge 2 ] && shift 2 || shift $#
# From here on, command arguments are $1, $2, ...

# ---- wifi via NetworkManager (Debian/systemd backend) -------------------
if [ "$WIFI_KIND" = nm ]; then
    case "$GROUP:$CMD" in
    wifi:status)
        [ -n "$WIFI_IF" ] || { echo "state=none"; exit 0; }
        ST=$(nmcli -t -f GENERAL.STATE,GENERAL.CONNECTION device show "$WIFI_IF" 2>/dev/null)
        echo "state=$(echo "$ST" | sed -n 's/^GENERAL.STATE:[0-9]* (\(.*\))/\1/p')"
        echo "ssid=$(echo "$ST" | sed -n 's/^GENERAL.CONNECTION://p')"
        exit 0 ;;
    wifi:scan)
        [ -n "$WIFI_IF" ] || exit 0
        nmcli -t -f SSID,SIGNAL device wifi list --rescan yes ifname "$WIFI_IF" 2>/dev/null |
            awk -F: '$1 != "" && !seen[$1]++ { printf "%s\t%d\n", $1, ($2 / 2) - 100 }'
        exit 0 ;;
    wifi:connect)
        [ -n "$WIFI_IF" ] || { echo "FAIL no adapter"; exit 1; }
        if [ -n "${2:-}" ]; then nmcli device wifi connect "$1" password "$2" ifname "$WIFI_IF" >/dev/null 2>&1
        else nmcli device wifi connect "$1" ifname "$WIFI_IF" >/dev/null 2>&1; fi && { echo OK; exit 0; }
        echo "FAIL"; exit 1 ;;
    esac
fi

case "$GROUP:$CMD" in
# ---- audio -------------------------------------------------------------
audio:volume/get)
    VOL=$(wpctl get-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9.]+' | head -1)
    [ -z "$VOL" ] && VOL=0
    VOLINT=$(awk -v v="$VOL" 'BEGIN { printf "%d", v * 100 + 0.5 }')
    MUTE=$(wpctl get-volume -l @DEFAULT_SINK@ 2>/dev/null | grep -oE 'MUTED' | head -1)
    [ -n "$MUTE" ] && MUTE=1 || MUTE=0
    echo "volume=$VOLINT"
    echo "muted=$MUTE"
    ;;
audio:volume/set)
    wpctl set-volume @DEFAULT_SINK@ "$1%" 2>/dev/null
    ;;
audio:volume/up)
    wpctl set-volume @DEFAULT_SINK@ 5%+ 2>/dev/null
    ;;
audio:volume/down)
    wpctl set-volume @DEFAULT_SINK@ 5%- 2>/dev/null
    ;;
audio:mute/toggle)
    wpctl set-mute @DEFAULT_SINK@ toggle 2>/dev/null
    ;;
audio:sinks)
    # id<TAB>name<TAB>1/0(default)
    wpctl list audio sinks 2>/dev/null | awk -F'\t' '
        { id=$1; name=$2; isdef=0; if ($4=="*") isdef=1;
          sub(/^alsa_output\./,"",name); sub(/^alsa_input\./,"",name);
          printf "%s\t%s\t%s\n", id, name, isdef }
    '
    ;;
audio:outputs)
    # Selectable outputs = card profiles that have a sink and are available:
    #   card<TAB>profile<TAB>description<TAB>active(1/0)
    pactl list cards 2>/dev/null | awk '
        /^Card #/ { card=""; inprof=0 }
        /^\tName: / { card=$2 }
        /^\tProfiles:/ { inprof=1; next }
        /^\tActive Profile: / { active[card]=substr($0, index($0, ": ")+2); inprof=0 }
        /^\t[A-Z]/ && !/^\tProfiles:/ { if (!/^\tActive/) inprof=0 }
        inprof && /^\t\t/ {
            line=$0; sub(/^\t\t/, "", line)
            name=line; sub(/: .*/, "", name)
            if (name ~ /\+input:/ || name == "off" || name == "pro-audio" || name ~ /^input:/) next
            if (line !~ /available: yes/) next
            desc=substr(line, length(name) + 3); sub(/ \(sinks.*/, "", desc)
            n++; c[n]=card; p[n]=name; d[n]=desc
        }
        END { for (i=1;i<=n;i++) printf "%s\t%s\t%s\t%d\n", c[i], p[i], d[i], (active[c[i]]==p[i] || index(active[c[i]], p[i] "+")==1) }
    '
    ;;
audio:output/set)
    # card profile -> switch, make its sink default, remember for next boot
    pactl set-card-profile "$1" "$2" 2>/dev/null || { echo "FAIL"; exit 1; }
    sleep 0.3
    SINK=$(wpctl list audio sinks 2>/dev/null | awk -F'\t' 'NR==1 {print $1}')
    [ -n "$SINK" ] && wpctl set-default "$SINK" 2>/dev/null
    printf 'AUDIO_CARD=%s\nAUDIO_PROFILE=%s\n' "$1" "$2" > "$FOYER_CONF/audio.conf"
    echo "OK"
    ;;
audio:output/restore)
    # Session start: restore the saved output, else prefer HDMI over analog
    # (laptop boards rank their speakers above HDMI).
    if [ -r "$FOYER_CONF/audio.conf" ]; then
        . "$FOYER_CONF/audio.conf"
        pactl set-card-profile "$AUDIO_CARD" "$AUDIO_PROFILE" 2>/dev/null && { echo "OK restored"; exit 0; }
    fi
    "$0" audio outputs | awk -F'\t' '$2 ~ /^output:hdmi-stereo$/ {print $1"\t"$2; exit}' | {
        IFS=$(printf '\t') read -r CARD PROF
        if [ -n "$PROF" ]; then pactl set-card-profile "$CARD" "$PROF" 2>/dev/null && echo "OK hdmi"; else echo "OK unchanged"; fi
    }
    ;;
audio:sink/set)
    # Set default sink by id or name
    ID=$(wpctl list audio sinks 2>/dev/null | awk -F'\t' -v want="$1" '
        { id=$1; name=$2; sub(/^alsa_output\./,"",name); sub(/^alsa_input\./,"",name);
          if (id==want || name==want) { print id; exit } }
    ')
    [ -n "$ID" ] && wpctl set-default "$ID" 2>/dev/null
    ;;
# ---- display -----------------------------------------------------------
display:modes)
    # Connector + mode + panel report (see display_report above).
    display_report
    ;;
display:native)
    # The panel's native mode (WxH@R), for session.sh WIDTH=native.
    display_report | sed -n 's/^native=//p' | head -1
    ;;
display:mode/confirm)
    # Keep the current mode: drop the revert point.
    rm -f "$SESSION_CONF.prev" "$SESSION_CONF.pending"
    echo "OK"
    ;;
display:mode/revert)
    if [ -f "$SESSION_CONF.prev" ]; then
        mv "$SESSION_CONF.prev" "$SESSION_CONF"
        rm -f "$SESSION_CONF.pending"
        echo "OK"
        ( sleep 1; be_restart_session ) >/dev/null 2>&1 &
    else
        echo "FAIL nothing to revert"; exit 1
    fi
    ;;
display:render/set)
    # Internal render size (UI/app) independent of output: WxH or "native"
    M="$1"
    [ -f "$SESSION_CONF" ] || { echo "FAIL no session.conf"; exit 1; }
    if [ "$M" = native ] || [ -z "$M" ]; then RW=""; RH=""
    else RW=$(echo "$M" | cut -dx -f1); RH=$(echo "$M" | cut -dx -f2); fi
    for kv in "RENDER_WIDTH=$RW" "RENDER_HEIGHT=$RH"; do
        k=${kv%%=*}
        if grep -q "^$k=" "$SESSION_CONF"; then sed -i "s/^$k=.*/$kv/" "$SESSION_CONF"
        else echo "$kv" >> "$SESSION_CONF"; fi
    done
    echo "OK"
    ( sleep 1; be_restart_session ) >/dev/null 2>&1 &
    ;;
display:mode/get)
    # Current gamescope output mode from session.conf (WIDTH=/HEIGHT=/RATE=;
    # WIDTH=native = the panel native mode, resolved by session.sh at boot)
    if [ -r "$SESSION_CONF" ]; then
        W=$(sed -n 's/^WIDTH=//p' "$SESSION_CONF" | head -1)
        H=$(sed -n 's/^HEIGHT=//p' "$SESSION_CONF" | head -1)
        R=$(sed -n 's/^RATE=//p' "$SESSION_CONF" | head -1)
    fi
    if [ "$W" = native ]; then echo "native"
    elif [ -n "$W" ] && [ -n "$H" ]; then echo "${W}x${H}@${R:-60}"
    else echo "auto"; fi
    RW=$(sed -n 's/^RENDER_WIDTH=//p' "$SESSION_CONF" 2>/dev/null | head -1)
    RH=$(sed -n 's/^RENDER_HEIGHT=//p' "$SESSION_CONF" 2>/dev/null | head -1)
    if [ -n "$RW" ] && [ -n "$RH" ]; then echo "render=${RW}x${RH}"; else echo "render=native"; fi
    if [ -f "$SESSION_CONF.pending" ]; then echo "pending=1"; fi
    ;;
display:mode/set)
    # Rewrite WIDTH/HEIGHT/RATE in session.conf and restart the session.
    # native = the panel native mode (resolved by session.sh at boot).
    M="$1"
    case "$M" in
    auto) W=""; H=""; R="" ;;
    native) W="native"; H=""; R="" ;;
    *)
        W=$(echo "$M" | cut -dx -f1)
        H=$(echo "$M" | cut -dx -f2 | cut -d@ -f1)
        R=$(echo "$M" | cut -s -d@ -f2); [ -n "$R" ] || R=60
        case "$W$H$R" in
            *[!0-9]*|"") echo "FAIL bad mode '$M'"; exit 1 ;;
        esac
        ;;
    esac
    if [ -f "$SESSION_CONF" ]; then
        cp "$SESSION_CONF" "$SESSION_CONF.prev"
        touch "$SESSION_CONF.pending"   # session.sh reverts if not confirmed
        for kv in "WIDTH=$W" "HEIGHT=$H" "RATE=$R"; do
            k=${kv%%=*}
            if grep -q "^$k=" "$SESSION_CONF"; then sed -i "s/^$k=.*/$kv/" "$SESSION_CONF"
            else echo "$kv" >> "$SESSION_CONF"; fi
        done
        echo "OK"
        # Restart the session: init respawns session.sh. gamescope ignores
        # SIGTERM, so SIGKILL it (after replying).
        ( sleep 1; be_restart_session ) >/dev/null 2>&1 &
    else
        echo "FAIL no session.conf"; exit 1
    fi
    ;;
# ---- wifi (wpa_supplicant backend) -------------------------------------
wifi:status)
    if [ -z "$WIFI_IF" ]; then echo "state=none"; exit 0; fi
    ST=$(wpa_cli -i "$WIFI_IF" status 2>/dev/null)
    WSTATE=$(echo "$ST" | grep '^wpa_state=' | cut -d= -f2)
    SSID=$(echo "$ST"  | grep '^ssid='     | cut -d= -f2)
    [ -z "$WSTATE" ] && WSTATE=disconnected
    echo "state=$WSTATE"
    echo "ssid=$SSID"
    ;;
wifi:scan)
    [ -z "$WIFI_IF" ] && exit 0
    wpa_cli -i "$WIFI_IF" scan >/dev/null 2>&1
    sleep 2
    TAB=$(printf '\t')
    wpa_cli -i "$WIFI_IF" scan_results 2>/dev/null | tail -n +2 |
    while IFS="$TAB" read -r bssid freq signal flags ssid; do
        [ -z "$ssid" ] && continue
        printf '%s\t%s\n' "$ssid" "$signal"
    done | sort -t"$TAB" -k2,2nr | awk -F"$TAB" '!seen[$1]++'
    ;;
wifi:connect)
    [ -z "$WIFI_IF" ] && { echo "FAIL no adapter"; exit 1; }
    SSID="$1"; PSK="$2"
    ID=$(wpa_cli -i "$WIFI_IF" add_network 2>/dev/null | tail -1)
    [ -z "$ID" ] && { echo "FAIL wpa_cli"; exit 1; }
    wpa_cli -i "$WIFI_IF" set_network "$ID" ssid "$(esc_wpa "$SSID")" >/dev/null
    if [ -n "$PSK" ]; then
        wpa_cli -i "$WIFI_IF" set_network "$ID" psk "$(esc_wpa "$PSK")" >/dev/null
    else
        wpa_cli -i "$WIFI_IF" set_network "$ID" key_mgmt NONE >/dev/null
    fi
    wpa_cli -i "$WIFI_IF" enable_network "$ID" >/dev/null
    wpa_cli -i "$WIFI_IF" save_config >/dev/null 2>&1
    i=0
    while [ $i -lt 20 ]; do
        WSTATE=$(wpa_cli -i "$WIFI_IF" status 2>/dev/null | grep '^wpa_state=' | cut -d= -f2)
        [ "$WSTATE" = "COMPLETED" ] && { echo "OK"; exit 0; }
        sleep 1; i=$((i+1))
    done
    echo "FAIL timeout"
    exit 1
    ;;
# ---- bluetooth ---------------------------------------------------------
bt:status)
    OUT=$(bluetoothctl show 2>/dev/null)
    [ -z "$OUT" ] && { echo "off"; exit 0; }
    echo "$OUT" | grep -q 'Powered: yes' && echo "powered" || echo "off"
    ;;
bt:devices)
    bluetoothctl devices 2>/dev/null | sed 's/^Device //;s/ /\t/'
    ;;
bt:scan)
    bluetoothctl --timeout 10 -- scan on >/dev/null 2>&1
    bluetoothctl devices 2>/dev/null | sed 's/^Device //;s/ /\t/'
    ;;
bt:pair)
    MAC="$1"
    bluetoothctl --timeout 20 -- pair "$MAC" >/dev/null 2>&1 || { echo "FAIL pair"; exit 1; }
    bluetoothctl trust "$MAC" >/dev/null 2>&1
    bluetoothctl connect "$MAC" >/dev/null 2>&1
    echo "OK"
    ;;
bt:power)
    bluetoothctl power "$1" >/dev/null 2>&1 && echo "OK" || echo "FAIL"
    ;;
# ---- net ---------------------------------------------------------------
net:status)
    # Summary lines (status bar): eth=<ip>|no link, wifi=<ip>|<state>|no adapter
    # Detail lines, one per interface (TAB-separated):
    #   iface <name> <type:ethernet|wifi> <state> <ip/cidr|-> <mac> <gateway|-> <dns|-> <speed|->
    GW_DEV=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')
    GW=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')
    DNS=$(awk '/^nameserver/ {printf "%s%s", sep, $2; sep=","}' /etc/resolv.conf 2>/dev/null)
    ETH=""
    for d in /sys/class/net/*; do
        n=$(basename "$d")
        [ "$n" = lo ] && continue
        [ "$(cat "$d/type" 2>/dev/null)" = 1 ] || continue   # ARPHRD_ETHER only
        case "$n" in
            docker*|veth*|br-*|virbr*) continue ;;
        esac
        if [ -d "$d/wireless" ] || [ -d "$d/phy80211" ]; then t=wifi; else t=ethernet; fi
        st=$(cat "$d/operstate" 2>/dev/null); [ -n "$st" ] || st=unknown
        mac=$(cat "$d/address" 2>/dev/null)
        ip4=$(ip -4 -o addr show dev "$n" 2>/dev/null | awk '{print $4; exit}')
        sp=$(cat "$d/speed" 2>/dev/null)
        case "$sp" in
            ""|-*) sp=- ;;
            *) sp="${sp} Mb/s" ;;
        esac
        if [ "$n" = "$GW_DEV" ]; then g=${GW:--}; dn=${DNS:--}; else g=-; dn=-; fi
        printf 'iface\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$t" "$st" "${ip4:--}" "${mac:--}" "$g" "$dn" "$sp"
        [ "$t" = ethernet ] && [ -z "$ETH" ] && [ -n "$ip4" ] && ETH=${ip4%/*}
    done
    [ -n "$ETH" ] && echo "eth=$ETH" || echo "eth=no link"
    if [ -n "$WIFI_IF" ]; then
        WSTATE=$(wpa_cli -i "$WIFI_IF" status 2>/dev/null | grep '^wpa_state=' | cut -d= -f2)
        WIP=$(ip -4 addr show "$WIFI_IF" 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')
        [ -n "$WIP" ] && echo "wifi=$WIP" || echo "wifi=${WSTATE:-disconnected}"
    else
        echo "wifi=no adapter"
    fi
    ;;
# ---- sys ---------------------------------------------------------------
sys:stats)
    # Live usage snapshot for Settings > Stats. CPU + network rates are
    # averaged over a short internal interval so each call is self-contained.
    # Lines (TAB separated): cpu %, core N %, mem kB, swap kB, load, proc
    # total/running, temp name milliC, gpu busy% MHz minmax, net iface B/s
    # rx tx, disk mount kB used/total, dio KB/s read write, up seconds.
    IFACES=$(for n in /sys/class/net/*; do
        i=${n##*/}
        case "$i" in lo|docker*|veth*|br-*|virbr*) continue ;; esac
        [ -r "$n/statistics/rx_bytes" ] || continue
        printf '%s ' "$i"
    done)
    # Root disk major:minor, for I/O rates (512 B sectors / 0.5 s window == KB/s)
    ROOTMM=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo 2>/dev/null)
    awk -v ifs="$IFACES" -v mm="$ROOTMM" 'BEGIN {
        NIF = split(ifs, IF, " ")
        if (mm != "") { split(mm, MM, ":"); MAJ = MM[1]; MIN = MM[2] }
        sample(0); system("sleep 0.5"); sample(1)
        for (i = 1; i <= NC; i++) {
            id = ID[i]
            dt = T[id ",1"] - T[id ",0"]; db = U[id ",1"] - U[id ",0"]
            pct = dt > 0 ? int(100 * db / dt + 0.5) : 0
            if (id == "cpu") printf "cpu\t%d\n", pct
            else printf "core\t%s\t%d\n", substr(id, 4), pct
        }
        for (i = 1; i <= NIF; i++) {
            rx = (NRX[IF[i] ",1"] - NRX[IF[i] ",0"]) / 0.5
            tx = (NTX[IF[i] ",1"] - NTX[IF[i] ",0"]) / 0.5
            printf "net\t%s\t%.0f\t%.0f\n", IF[i], rx, tx
        }
        if (mm != "") printf "dio\t%d\t%d\n", DR[1] - DR[0], DW[1] - DW[0]
        while ((getline l < "/proc/meminfo") > 0) {
            split(l, a, ":")
            if (a[1] == "MemTotal") MT = a[2] + 0
            else if (a[1] == "MemAvailable") MA = a[2] + 0
            else if (a[1] == "SwapTotal") SW = a[2] + 0
            else if (a[1] == "SwapFree") SF = a[2] + 0
        }
        close("/proc/meminfo")
        printf "mem\t%d\t%d\n", MT, MA
        printf "swap\t%d\t%d\n", SW, SW - SF
        getline l < "/proc/loadavg"; split(l, a, " ")
        printf "load\t%s\t%s\t%s\n", a[1], a[2], a[3]
        split(a[4], b, "/"); printf "proc\t%s\t%s\n", b[2], b[1]
        getline l < "/proc/uptime"; split(l, a, " "); printf "up\t%s\n", a[1]
    }
    function sample(s,  l, a, i, id, t, u, rx, tx) {
        while ((getline l < "/proc/stat") > 0) {
            if (l !~ /^cpu[0-9]*[ \t]/) continue
            split(l, a, /[ \t]+/)
            id = a[1]; t = 0
            for (i = 2; i <= 9; i++) t += a[i]
            u = t - a[5] - a[6]
            if (!(id in SEEN)) { SEEN[id]; ID[++NC] = id }
            U[id "," s] = u; T[id "," s] = t
        }
        close("/proc/stat")
        for (i = 1; i <= NIF; i++) {
            rx = 0; tx = 0
            getline rx < ("/sys/class/net/" IF[i] "/statistics/rx_bytes")
            getline tx < ("/sys/class/net/" IF[i] "/statistics/tx_bytes")
            close("/sys/class/net/" IF[i] "/statistics/rx_bytes")
            close("/sys/class/net/" IF[i] "/statistics/tx_bytes")
            NRX[IF[i] "," s] = rx + 0; NTX[IF[i] "," s] = tx + 0
        }
        if (mm != "") {
            while ((getline l < "/proc/diskstats") > 0) {
                split(l, a, " ")
                if (a[1] == MAJ && a[2] == MIN) { DR[s] = a[6] + 0; DW[s] = a[10] + 0; break }
            }
            close("/proc/diskstats")
        }
    }' /dev/null
    # Thermal zones (skip zones reporting nonsense like 0C)
    for z in /sys/class/thermal/thermal_zone*/; do
        [ -r "$z/temp" ] || continue
        t=$(cat "$z/temp" 2>/dev/null) || continue
        case "$t" in ''|*[!0-9-]*) continue ;; esac
        [ "$t" -lt 10000 ] && continue
        printf 'temp\t%s\t%s\n' "$(cat "$z/type" 2>/dev/null || echo zone)" "$t"
    done
    # GPU load/frequency, best effort: amdgpu sysfs, i915 gt sysfs
    for c in /sys/class/drm/card[0-9]*; do
        [ -d "$c" ] || continue
        b=$(cat "$c/device/gpu_busy_percent" 2>/dev/null)
        f=""
        [ -r "$c/gt_cur_freq_mhz" ] && f=$(cat "$c/gt_cur_freq_mhz")
        [ -z "$f" ] && [ -r "$c/gt/gt0/cur_freq_mhz" ] && f=$(cat "$c/gt/gt0/cur_freq_mhz")
        [ -z "$f" ] && [ -r "$c/device/pp_dpm_sclk" ] && \
            f=$(awk '/\*/{gsub(/[^0-9]/, "", $2); print $2}' "$c/device/pp_dpm_sclk" 2>/dev/null | head -1)
        lo=""; hi=""
        [ -r "$c/gt_min_freq_mhz" ] && lo=$(cat "$c/gt_min_freq_mhz")
        [ -r "$c/gt_max_freq_mhz" ] && hi=$(cat "$c/gt_max_freq_mhz")
        [ -z "$lo" ] && [ -r "$c/gt/gt0/rps_min_freq_mhz" ] && lo=$(cat "$c/gt/gt0/rps_min_freq_mhz")
        [ -z "$hi" ] && [ -r "$c/gt/gt0/rps_max_freq_mhz" ] && hi=$(cat "$c/gt/gt0/rps_max_freq_mhz")
        if [ -z "$lo$hi" ] && [ -r "$c/device/pp_dpm_sclk" ]; then
            lo=$(awk '!/\*/{gsub(/[^0-9]/, "", $2); print $2; exit}' "$c/device/pp_dpm_sclk" 2>/dev/null)
            hi=$(awk '!/\*/{gsub(/[^0-9]/, "", $2); last = $2} END { if (last != "") print last }' "$c/device/pp_dpm_sclk" 2>/dev/null)
        fi
        [ -n "$b$f" ] && printf 'gpu\t%s\t%s\t%s\t%s\n' "${b:--}" "${f:--}" "${lo:--}" "${hi:--}"
    done
    # Storage: every real mount (pseudo filesystems and loop devices skipped)
    df -k 2>/dev/null | awk 'NR > 1 {
        d = $1
        if (d ~ /^(tmpfs|devtmpfs|devpts|proc|sysfs|cgroup|cgroup2|overlay|squashfs|efivarfs|none|udev|shm|mqueue|ramfs|autofs|hugetlbfs|bpf|nsfs|composefs)$/) next
        if (d ~ /^\/dev\/loop/) next
        printf "disk\t%s\t%s\t%s\n", $6, $3, $2
    }'
    ;;
sys:procs)
    # Top N processes by CPU (default 10), same double-sample pattern as
    # sys stats. Lines: proc PID CPU% MEM_KB NAME, CPU desc.
    N=${1:-10}
    PIDS=""
    for p in /proc/[0-9]*/stat; do
        [ -r "$p" ] || continue
        d=${p%/stat}
        PIDS="$PIDS ${d##*/}"
    done
    NPROC=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
    PAGEKB=$(( $(getconf PAGESIZE 2>/dev/null || echo 4096) / 1024 ))
    awk -v pids="$PIDS" -v nproc="$NPROC" -v n="$N" -v pagekb="$PAGEKB" 'BEGIN {
        NP = split(pids, P, " ")
        sample(0); system("sleep 0.5"); sample(1)
        dt = TT[1] - TT[0]
        m = 0
        for (i = 1; i <= NP; i++) {
            id = P[i]
            if (!(id in U1)) continue   # died between samples
            d = U1[id] - U0[id]
            pct = dt > 0 ? 100 * d * nproc / dt : 0
            if (pct < 0) pct = 0
            if (pct > 100 * nproc) pct = 100 * nproc
            cpu[i] = pct
        }
        for (i = 1; i <= NP; i++)
            if (i in U1) { m++; IDX[m] = i }
        for (i = 2; i <= m; i++) {   # insertion sort, cpu desc
            v = IDX[i]
            for (j = i - 1; j >= 1 && cpu[IDX[j]] < cpu[v]; j--) IDX[j + 1] = IDX[j]
            IDX[j + 1] = v
        }
        for (i = 1; i <= m && i <= n; i++) {
            id = P[IDX[i]]
            printf "proc\t%s\t%.1f\t%d\t%s\n", id, cpu[IDX[i]], MEM[id] * pagekb, NAME[id]
        }
    }
    function sample(s,   i, id, l, a, k, t) {
        while ((getline l < "/proc/stat") > 0) {
            if (l !~ /^cpu /) continue
            split(l, a, " "); t = 0
            for (k = 2; k <= 9; k++) t += a[k]
            TT[s] = t
            break
        }
        close("/proc/stat")
        for (i = 1; i <= NP; i++) {
            id = P[i]
            if ((getline l < ("/proc/" id "/stat")) <= 0) continue
            close("/proc/" id "/stat")
            split(l, a, " ")
            # comm may contain spaces/parens: the field ending in ")" whose
            # next field is a process state char
            k = 0
            for (k = 1; k < 25; k++)
                if (a[k] ~ /\)$/ && a[k + 1] ~ /^[SRDXZTIWPx]$/) break
            if (k > 24) continue   # no ")" + state field found
            if (s == 0) U0[id] = a[k + 12] + 0 + a[k + 13] + 0
            else U1[id] = a[k + 12] + 0 + a[k + 13] + 0
            if ((getline l < ("/proc/" id "/comm")) > 0) { sub(/\r?\n$/, "", l); NAME[id] = l }
            close("/proc/" id "/comm")
            if ((getline l < ("/proc/" id "/statm")) > 0) { split(l, a, " "); MEM[id] = a[2] + 0 }
            close("/proc/" id "/statm")
        }
    }' /dev/null
    ;;
sys:kill)
    kill -TERM "$1" 2>/dev/null && echo "OK" || { echo "FAIL"; exit 1; }
    ;;
sys:info)
    echo "hostname=$(hostname)"
    echo "timezone=$(cat /etc/timezone 2>/dev/null || readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
    # Storage (root fs free)
    df -h / 2>/dev/null | awk 'NR==2 {print $4" free of "$2}' | sed 's/^/storage=/'
    # RAM
    free -h 2>/dev/null | awk '/Mem:/ {print "ram="$3" used of "$2}'
    # CPU temp
    TEMP=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -1)
    if [ -n "$TEMP" ]; then
        echo "temp=$((TEMP / 1000))C"
    else
        echo "temp=n/a"
    fi
    # Uptime (busybox has no -p)
    echo "uptime=$(uptime 2>/dev/null | sed 's/.*up \([^,]*\),.*/\1/')"
    ;;
sys:timezone/cycle)
    TZ=$(cat /etc/timezone 2>/dev/null)
    # Simple cycle through a few common zones
    case "$TZ" in
        UTC) NEXT="America/New_York" ;;
        America/New_York) NEXT="Europe/London" ;;
        Europe/London) NEXT="Europe/Berlin" ;;
        Europe/Berlin) NEXT="UTC" ;;
        *) NEXT="UTC" ;;
    esac
    setup-timezone "$NEXT" >/dev/null 2>&1
    echo "$NEXT"
    ;;
sys:ntp/sync)
    be_ntp_sync && echo "OK" || { echo "FAIL"; exit 1; }
    ;;
sys:upgrade)
    if command -v foyer-update >/dev/null 2>&1; then foyer-update 2>&1; fi
    be_upgrade 2>&1
    echo "OK"
    ;;
# ---- power -------------------------------------------------------------
power:shutdown) be_poweroff ;;
power:reboot)   be_reboot ;;
power:suspend)  be_suspend ;;
*)
    echo "usage: foyer-ctl <group> <cmd> [args]" >&2
    exit 1
    ;;
esac
