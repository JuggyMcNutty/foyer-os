    VIC[45]="1440x576@100 i"
    VIC[46]="1920x1080@120 i"
    VIC[47]="1280x720@120"
    VIC[48]="720x480@120"
    VIC[49]="720x480@120"
    VIC[50]="1440x480@120 i"
    VIC[51]="1440x480@120 i"
    VIC[52]="720x576@200"
    VIC[53]="720x576@200"
    VIC[54]="1440x576@200 i"
    VIC[55]="1440x576@200 i"
    VIC[56]="720x480@240"
    VIC[57]="720x480@240"
    VIC[58]="1440x480@240 i"
    VIC[59]="1440x480@240 i"
    VIC[60]="1280x720@24"
    VIC[61]="1280x720@25"
    VIC[62]="1280x720@30"
