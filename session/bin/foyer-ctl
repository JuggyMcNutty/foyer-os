    EST[13]="1024x768@70"
    EST[14]="1024x768@75"
    EST[15]="1280x1024@75"
    EST[16]="1152x870@75"
    VIC[1]="640x480@60"
    VIC[2]="720x480@60"
    VIC[3]="720x480@60"
    VIC[4]="1280x720@60"
    VIC[5]="1920x1080@60 i"
    VIC[6]="1440x480@60 i"
    VIC[7]="1440x480@60 i"
    VIC[8]="1440x240@60"
    VIC[9]="1440x240@60"
    VIC[10]="2880x480@60 i"
    VIC[11]="2880x480@60 i"
    VIC[12]="2880x240@60"
    VIC[13]="2880x240@60"
    VIC[14]="1440x480@60"
    VIC[15]="1440x480@60"
    VIC[16]="1920x1080@60"
    VIC[17]="720x576@50"
    VIC[18]="720x576@50"
    VIC[19]="1280x720@50"
    VIC[20]="1920x1080@50 i"
    VIC[21]="1440x576@50 i"
    VIC[22]="1440x576@50 i"
    VIC[23]="1440x288@50"
    VIC[24]="1440x288@50"
    VIC[25]="2880x576@50 i"
    VIC[26]="2880x576@50 i"
    VIC[27]="2880x288@50"
    VIC[28]="2880x288@50"
    VIC[29]="1440x576@50"
    VIC[30]="1440x576@50"
    VIC[31]="1920x1080@50"
    VIC[32]="1920x1080@24"
    VIC[33]="1920x1080@25"
    VIC[34]="1920x1080@30"
    VIC[35]="2880x480@60"
    VIC[36]="2880x480@60"
    VIC[37]="2880x576@50"
    VIC[38]="2880x576@50"
    VIC[39]="1920x1080@50 i"
    VIC[40]="1920x1080@100 i"
    VIC[41]="1280x720@100"
