#!/bin/sh
# foyer-ctl — single system-control backend for the Foyer launcher (formerly
# htpc-ctl/htpc-net; compat symlinks are installed). Line-oriented, TAB-separated output. Runs as root in the
# session. Always invoked through the launcher's job queue (never synchronous).
#
# Groups:
#   audio   volume/get volume/set N volume/up volume/down mute/toggle sinks sink/set NAME
#           outputs output/set CARD PROFILE output/restore
#   display modes mode/get mode/set WxH@R|native|auto mode/confirm mode/revert native
#           render/set WxH|native
#   wifi    status scan connect SSID PSK
#   bt      status devices scan pair MAC power on|off
#   net     status
#   sys     info stats procs [N] kill PID timezone/cycle ntp/sync upgrade
#   power   shutdown reboot suspend
#
# display modes parses the connected display's EDID (base block + CTA-861):
#   connector\tNAME\tSTATUS\tTYPE   once per DRM connector (first connected wins)
#   mode\tWxH\tREFRESH\t[native|preferred]
#   KEY=VALUE lines (name, make, model, year, size, native, preferred, hdr,
#   vrr, colorimetry, deepcolor, cb420, cb420_depth, audio, phys, tmds,
#   char_rate, scdc, underscan). "native" = the panel's own resolution
#   (highest-area mode of the preferred aspect), preferred = EDID DTD 1.
# Without a valid EDID the mode list falls back to DRM sysfs names at 60 Hz.
# session.conf: WIDTH=native resolves the panel mode at boot (session.sh).

# Config dir: /etc/foyer (legacy /etc/htpc honoured until re-provisioned)
FOYER_CONF=${FOYER_CONF:-/etc/foyer}
[ -d "$FOYER_CONF" ] || FOYER_CONF=/etc/htpc
SESSION_CONF="$FOYER_CONF/session.conf"

# Init/network backend (OpenRC+wpa_supplicant on Alpine, systemd+NM on Debian)
if [ -d /run/systemd/system ]; then FOYER_INIT=systemd; else FOYER_INIT=openrc; fi
for _b in "/usr/lib/foyer/backend_$FOYER_INIT.sh" "$(dirname "$0")/../backend_$FOYER_INIT.sh"; do
    [ -r "$_b" ] && { . "$_b"; break; }
done
command -v be_poweroff >/dev/null 2>&1 || {
    be_poweroff() { poweroff; }; be_reboot() { reboot; }; be_suspend() { echo mem > /sys/power/state; }
    be_restart_session() { pkill -9 -x gamescope-wl 2>/dev/null || pkill -9 -x gamescope 2>/dev/null; }
    be_ntp_sync() { return 1; }; be_upgrade() { return 1; }; be_wifi_kind() { echo wpa; }
}
WIFI_KIND=$(be_wifi_kind)

WIFI_IF=""
for iface in /sys/class/net/*; do
    case "$(basename "$iface")" in
        wl*|wlan*) WIFI_IF=$(basename "$iface"); break ;;
    esac
done

esc_wpa() {
    printf '"%s"' "$(printf '%s' "$1" | sed 's/"/\\"/g')"
}

# ---- display (EDID) -------------------------------------------------------
# Parse the EDID of $1 (a connected DRM connector) with POSIX awk:
# mode lines + panel info lines (see the header comment). Checks both
# checksums, skips interlaced modes. Exits 1 without output if the EDID
# is missing/short/corrupt so callers can fall back. The mode tables are
# generated from edid-decode (v4l-utils utils/edid-decode); see
# scripts/gen-edid-tables.py.
edid_parse() {
    od -An -v -tu1 "$1" 2>/dev/null | awk '# EDID parser - POSIX awk (busybox-safe). Reads decimal bytes on stdin
# (od -An -v -tu1) and prints a machine-readable report.
# Structure/rules cross-validated against edid-decode (v4l-utils).


function emit(k, v) { printf "%s=%s\n", k, v }
function add_mode(w, h, r, il,   a, ar) {
    if (w < 1 || h < 1 || r < 1 || il) return
    MODE[w "x" h "@" r] = 1
    if (PREFW > 0) {                       # native = max-area mode of the
        ar = (w + 0.0) / h / ((PREFW + 0.0) / PREFH)   # preferred aspect
        if (ar < 0.98 || ar > 1.02) return
    }
    a = w * h
    if (NATA < a || (NATA == a && NATR < r)) { NATW = w; NATH = h; NATR = r; NATA = a }
}
function dtd(o,  pclk, ha, hb, va, vb, r, il) {
    pclk = ED[o] + ED[o + 1] * 256
    if (pclk == 0) return 0
    ha = ED[o + 2] + 256 * int(ED[o + 4] / 16)
    hb = ED[o + 3] + 256 * (ED[o + 4] % 16)
    va = ED[o + 5] + 256 * int(ED[o + 7] / 16)
    vb = ED[o + 6] + 256 * (ED[o + 7] % 16)
    if (ha < 1 || va < 1) return 0
    il = int(ED[o + 17] / 128)
    r = int(pclk * 10000 / ((ha + hb) * (va + vb)) + 0.5)
    add_mode(ha, va, r, il)
    if (!PREFW) { PREFW = ha; PREFH = va; PREFR = r }
    return 1
}
function letters(b1, b2) {
    return substr(AZ, int(b1 / 4) % 32, 1) substr(AZ, (b1 % 4) * 8 + int(b2 / 32), 1) substr(AZ, b2 % 32, 1)
}
function dstr(o,  s, i) {
    s = ""
    for (i = o + 5; i <= o + 17; i++)
        if (ED[i] >= 32 && ED[i] < 127) s = s sprintf("%c", ED[i])
    sub(/ +$/, "", s)
    return s
}
function vic_mode(v,  m) {          # "WxH@R" or "WxH@R i"
    m = VIC[v]
    if (!m) return ""
    return m
}
function add_str_mode(m,  a, b) {   # parse "WxH@R[ i]"
    if (!m) return
    split(m, a, "@")
    split(a[1], b, "x")
    add_mode(b[1], b[2], a[2], (index(m, "i") > 0))
}
function cta(b0,  s, d, i, tag, len, p, j, v, e, x, f, w, m, n) {
    s = 0
    for (i = b0; i < b0 + 128; i++) s += ED[i]
    if (s % 256) return                    # bad CTA checksum
    if (ED[b0] != 2 || ED[b0 + 1] < 2) return
    d = ED[b0 + 2]
    if (d >= 128) return
    if (int(ED[b0 + 3] / 128) % 2) emit("underscan", "yes")
    if (d < 4) return                      # no data blocks, no DTDs
    nvic = 0
    i = b0 + 4
    while (i < b0 + d) {
        tag = int(ED[i] / 32)
        len = ED[i] % 32
        p = i + 1
        if (len == 0 || p + len > b0 + 127) break
        if (tag == 2) {                    # video data block: VICs
            for (j = 0; j < len; j++) {
                v = ED[p + j]
                VICL[nvic++] = v
                add_str_mode(vic_mode(v))
            }
        } else if (tag == 1) {             # audio data block
            for (j = 0; j + 2 < len; j += 3) {
                x = ED[p + j]
                f = int(x / 8) % 16
                w = x % 8 + 1
                AUD = AUD (AUD == "" ? "" : ", ") (f == 1 ? "LPCM " w "ch" :
                    f == 2 ? "DD 5.1" : f == 7 ? "DTS" : f == 10 ? "DD+" :
                    f == 11 ? "DTS-HD" : f == 12 ? "TrueHD" : "")
            }
        } else if (tag == 3) {              # vendor specific data block
            v = ED[p] + ED[p + 1] * 256 + ED[p + 2] * 65536
            if (v == 3075) {                # HDMI licensing (00-0C-03)
                emit("phys", sprintf("%x.%x.%x.%x", int(ED[p + 3] / 16), ED[p + 3] % 16, int(ED[p + 4] / 16), ED[p + 4] % 16))
                x = ED[p + 5]
                DC = ""
                if (int(x / 64) % 2) DC = DC (DC == "" ? "" : ", ") "48-bit"
                if (int(x / 32) % 2) DC = DC (DC == "" ? "" : ", ") "36-bit"
                if (int(x / 16) % 2) DC = DC (DC == "" ? "" : ", ") "30-bit"
                if (int(x / 8) % 2) DC = DC (DC == "" ? "" : ", ") "RGB 4:4:4"
                if (len >= 7) emit("tmds", ED[p + 6] * 5 " MHz")
                # HDMI VIC list (CTA-861-F): 2160p timings often ONLY exist
                # here, not in the CTA video data block. x[k] = ED[p+3+k]:
                # x[4] 0x20 = list present, x[5] 3D byte, x[6] count byte
                # (top 3 bits), VICs follow (latency fields shift them).
                # HDMI VIC -> CTA VIC: 1=95 2=94 3=93 (3840x2160 30/25/24),
                # 4=98 5=99 6=100 (4096x2160 24/25/30).
                if (len >= 8 && int(ED[p + 7] / 32) % 2) {
                    xb = 5
                    if (int(ED[p + 7] / 128) % 2) { xb += 2; if (int(ED[p + 7] / 64) % 2) xb += 2 }
                    if (xb + 5 <= len) {
                        nv = int(ED[p + 3 + xb + 1] / 32) % 8
                        for (j = 0; j < nv && xb + 2 + j <= len - 4; j++) {
                            hv = ED[p + 3 + xb + 2 + j]
                            if (hv == 1) add_str_mode(VIC[95])
                            else if (hv == 2) add_str_mode(VIC[94])
                            else if (hv == 3) add_str_mode(VIC[93])
                            else if (hv == 4) add_str_mode(VIC[98])
                            else if (hv == 5) add_str_mode(VIC[99])
                            else if (hv == 6) add_str_mode(VIC[100])
                        }
                    }
                }
            } else if (v == 12869080) {     # HDMI Forum (C4-5D-D8)
                emit("char_rate", ED[p + 4] * 5 " MHz")
                if (int(ED[p + 5] / 128) % 2) emit("scdc", "yes")
                x = ED[p + 6] % 16
                CB2 = ""
                if (int(x / 4) % 2) CB2 = CB2 (CB2 == "" ? "" : ", ") "16-bit"
                if (int(x / 2) % 2) CB2 = CB2 (CB2 == "" ? "" : ", ") "12-bit"
                if (x % 2) CB2 = CB2 (CB2 == "" ? "" : ", ") "10-bit"
                x = len - 3
                if (x >= 8 && int(ED[p + 7] / 2) % 2) emit("allm", "yes")
                if (x >= 10) {             # HDMI 2.1 VRR
                    e = ED[p + 8] % 64
                    if (e) emit("vrr", e "-" int(ED[p + 8] / 64) * 16 + ED[p + 9] " Hz (HDMI 2.1)")
                }
            } else if (v == 26) {           # AMD (00-00-1A): FreeSync
                if (len >= 7 && int(ED[p + 4] / 1) % 2 == 1) AMDVRR = ED[p + 5] "-" ED[p + 6] " Hz"
            }
        } else if (tag == 7) {              # extended tags
            e = ED[p]
            if (e == 5) {                   # colorimetry
                x = ED[p + 1]
                for (j = 0; j < 8; j++)
                    if (int(x / PW[j]) % 2) COL = COL (COL == "" ? "" : ", ") CM1[j]
                x = ED[p + 2]
                for (j = 0; j < 8; j++)
                    if (int(x / PW[j]) % 2) COL = COL (COL == "" ? "" : ", ") CM2[j]
            } else if (e == 6) {            # HDR static metadata
                x = ED[p + 1]
                HDR = ""
                for (j = 0; j < 6; j++)
                    if (int(x / PW[j]) % 2) HDR = HDR (HDR == "" ? "" : ", ") EOTF[j]
                if (index(HDR, "ST.2084")) HDR = "HDR10 (ST.2084)" (index(HDR, "HLG") ? " + HLG" : "")
                else if (HDR != "") HDR = "HDR (" HDR ")"
                if (len - 1 >= 3) HDRMAX = int(50 * exp(log(2) * ED[p + 3] / 32) + 0.5)
                if (len - 1 >= 5) HDRMIN = int(HDRMAX * (ED[p + 5] / 255) ^ 2 / 100 + 0.5)
            } else if (e == 15) {           # YCbCr 4:2:0 capability map
                for (j = 1; j < len; j++) {
                    x = ED[p + j]
                    for (w = 7; w >= 0; w--)
                        if (int(x / PW2[w]) % 2) {
                            v = VICL[(j - 1) * 8 + 7 - w]
                            if (v && index(CB420, " " v ",") == 0) CB420 = CB420 " " v ","
                        }
                }
            }
        }
        i += len + 1
    }
    for (j = b0 + d; j + 17 < b0 + 127; j += 18) dtd(j)
}
BEGIN {
    AZ = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    PW[0] = 1; PW[1] = 2; PW[2] = 4; PW[3] = 8; PW[4] = 16; PW[5] = 32; PW[6] = 64; PW[7] = 128
    PW2[0] = 128; PW2[1] = 64; PW2[2] = 32; PW2[3] = 16; PW2[4] = 8; PW2[5] = 4; PW2[6] = 2; PW2[7] = 1
    EOTF[0] = "SDR"; EOTF[1] = "HDR gamma"; EOTF[2] = "ST.2084"; EOTF[3] = "HLG"
    CM1[0] = "xvYCC601"; CM1[1] = "xvYCC709"; CM1[2] = "sYCC601"; CM1[3] = "opYCC601"; CM1[4] = "opRGB"; CM1[5] = "BT.2020cYCC"; CM1[6] = "BT.2020YCC"; CM1[7] = "BT.2020RGB"
    CM2[0] = "GBP0"; CM2[4] = "Default"; CM2[5] = "sRGB"; CM2[6] = "ICtCp"; CM2[7] = "ST2113RGB"
        EST[0]="720x400@70"
    EST[1]="720x400@88"
    EST[2]="640x480@60"
    EST[3]="640x480@67"
    EST[4]="640x480@73"
