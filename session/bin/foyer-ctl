    VIC[116]="3840x2160@48"
    VIC[117]="3840x2160@100"
    VIC[118]="3840x2160@120"
    VIC[119]="3840x2160@100"
    VIC[120]="3840x2160@120"
    VIC[121]="5120x2160@24"
